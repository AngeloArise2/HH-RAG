# --- Speech-to-text (pick ONE provider, set the other's key blank) ---
STT_PROVIDER=sarvam            # sarvam | elevenlabs
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# --- LLM for answer generation ---
LLM_PROVIDER=groq              # groq | gemini
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Vector store (local, no key needed for Chroma) ---
VECTOR_STORE=chroma
VECTOR_STORE_PATH=./backend/data/index

# --- Dataset ingestion ---
DATASET_LANGUAGE=hin            # which per-language parquet shard to read
DATASET_SPLIT=validation        # validation shards are ~460MB vs ~4GB train shards
MAX_RAW_ROWS=10000              # query rows to read before stopping

# --- App ---
APP_ENV=development
LOG_LEVEL=info
